APP_NAME="Class Schedule System"
APP_ENV=production
APP_KEY=base64:o9s7K2xPqL8nM1bV3cF5gH7jD9eR2tU4wA6sB8cD0fE1gH2iJ3kL4mN5oP6qR7sT8=
APP_DEBUG=false
APP_URL=https://class-sched.railway.app

LOG_CHANNEL=single
LOG_LEVEL=info

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=schedule_system
DB_USERNAME=postgres
DB_PASSWORD=

# For Railway deployment
DATABASE_URL=postgresql://localhost:5432/schedule_system

# Session
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file
CACHE_STORE=file

# Queue
QUEUE_CONNECTION=sync

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@classschedule.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS/S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Application Settings
TIMEZONE=UTC
SEMESTER=1
ACADEMIC_YEAR=2024-2025
